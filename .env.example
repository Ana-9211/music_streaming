# WAVELINK Environment Configuration
# Copy this file to .env and modify values as needed

# Server Configuration
SERVER_HOST=127.0.0.1
STREAM_PORT=9893
WEB_PORT=9894

# Audio Streaming
CHUNK_SIZE=4096
MAX_CLIENTS=5
MUSIC_FOLDER=music

# Buffering
DEMO_MODE=true
MAX_CHUNKS=200
MAX_TP=400

# Development
DEBUG=false
LOG_LEVEL=INFO
